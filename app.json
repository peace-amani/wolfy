{
  "name": "WOLFY WhatsApp Bot",
  "description": "Multi-session WhatsApp SaaS bot powered by Baileys",
  "repository": "https://github.com/777Wolf-dot/wolf-bot",
  "keywords": ["whatsapp", "bot", "baileys", "nodejs"],
  "stack": "heroku-22",
  "buildpacks": [
    { "url": "heroku/nodejs" }
  ],
  "env": {
    "MONGODB_URI": {
      "description": "MongoDB Atlas connection string (mongodb+srv://...)",
      "required": true
    },
    "ADMIN_API_KEY": {
      "description": "Secret key protecting /admin/* endpoints",
      "required": true
    },
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production"
    },
    "GITHUB_REPO": {
      "description": "GitHub repo slug for update version checks",
      "value": "777Wolf-dot/wolf-bot",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": []
}
